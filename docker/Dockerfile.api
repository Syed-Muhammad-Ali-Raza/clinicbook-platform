# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/aspnet:11.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
USER $APP_UID

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
ARG BUILD_CONFIGURATION=Release
WORKDIR /src

COPY Directory.Build.props Directory.Packages.props global.json ClinicBook.sln ./
COPY src/ClinicBook.Domain/ClinicBook.Domain.csproj src/ClinicBook.Domain/
COPY src/ClinicBook.Application/ClinicBook.Application.csproj src/ClinicBook.Application/
COPY src/ClinicBook.Infrastructure/ClinicBook.Infrastructure.csproj src/ClinicBook.Infrastructure/
COPY src/ClinicBook.Api/ClinicBook.Api.csproj src/ClinicBook.Api/
COPY tests/ClinicBook.Domain.Tests/ClinicBook.Domain.Tests.csproj tests/ClinicBook.Domain.Tests/
COPY tests/ClinicBook.Application.Tests/ClinicBook.Application.Tests.csproj tests/ClinicBook.Application.Tests/
COPY tests/ClinicBook.Infrastructure.Tests/ClinicBook.Infrastructure.Tests.csproj tests/ClinicBook.Infrastructure.Tests/
COPY tests/ClinicBook.Api.IntegrationTests/ClinicBook.Api.IntegrationTests.csproj tests/ClinicBook.Api.IntegrationTests/

RUN dotnet restore ClinicBook.sln

COPY . .
RUN dotnet build src/ClinicBook.Api/ClinicBook.Api.csproj -c $BUILD_CONFIGURATION -o /app/build --no-restore

FROM build AS publish
ARG BUILD_CONFIGURATION=Release
RUN dotnet publish src/ClinicBook.Api/ClinicBook.Api.csproj -c $BUILD_CONFIGURATION -o /app/publish /p:UseAppHost=false --no-restore

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=5 CMD curl -f http://localhost:8080/health/live || exit 1
ENTRYPOINT ["dotnet", "ClinicBook.Api.dll"]
