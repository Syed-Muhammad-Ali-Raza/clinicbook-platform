# Core
ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__Default=Host=postgres;Port=5432;Database=clinicbook;Username=clinicbook;Password=clinicbook_dev_password

# Redis
Redis__Connection=redis:6379,abortConnect=false

# JWT / Auth (development only placeholders)
Jwt__Issuer=https://localhost:5001
Jwt__Audience=clinicbook-api
Jwt__AccessTokenMinutes=15
Jwt__RefreshTokenDays=14
Jwt__SigningKey=DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+CHARS
Jwt__KeyPath=/run/secrets/jwt-signing-key.pem
AuthCookies__Secure=true
AuthCookies__AccessTokenName=cb_access
AuthCookies__RefreshTokenName=cb_refresh
AuthCookies__CsrfCookieName=cb_csrf
AuthCookies__CsrfHeaderName=X-CSRF-TOKEN

# Stripe
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
Stripe__PublishableKey=pk_test_replace_me

# Email (SMTP / SendGrid)
Smtp__Host=mailhog
Smtp__Port=1025
Smtp__Username=
Smtp__Password=
Smtp__FromAddress=no-reply@clinicbook.local
Smtp__FromName=ClinicBook

# SMS (Twilio)
Sms__Provider=twilio
Sms__AccountSid=AC_replace_me
Sms__AuthToken=replace_me
Sms__FromNumber=+10000000000

# CORS
Cors__AllowedOrigins=http://localhost:5173,https://localhost:5173

# Observability
Seq__ServerUrl=http://seq:5341

# Storage
Storage__Provider=Local
Storage__LocalPath=/app/uploads
Storage__EncryptionKey=replace-with-base64-key

# Feature flags
FeatureManagement__AiAssistant=false
