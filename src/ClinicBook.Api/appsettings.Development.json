{
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=clinicbook;Username=clinicbook;Password=clinicbook_dev_password"
  },
  "Redis": {
    "Connection": "localhost:6379,abortConnect=false"
  },
  "Jwt": {
    "Issuer": "https://localhost:8080",
    "Audience": "clinicbook-api-dev",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningKey": "DEV_ONLY_CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY_32+CHARS"
  },
  "AuthCookies": {
    "Secure": false
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:8081" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "System": "Information"
      }
    }
  }
}
