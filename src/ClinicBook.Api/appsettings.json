{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Redis": {
    "Connection": ""
  },
  "Jwt": {
    "Issuer": "ClinicBook",
    "Audience": "ClinicBook.Api",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningKey": ""
  },
  "AuthCookies": {
    "AccessTokenName": "cb_access",
    "RefreshTokenName": "cb_refresh",
    "CsrfCookieName": "cb_csrf",
    "CsrfHeaderName": "X-CSRF-TOKEN",
    "Secure": true
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.Seq" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId" ],
    "Properties": {
      "Application": "ClinicBook.Api"
    }
  }
}
